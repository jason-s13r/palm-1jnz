// The 1j.nz Worker, deployed by Workers Builds from the `cloudflare` branch.
// Started from palm's wrangler.template.jsonc.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "palm-1jnz",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  // Until go-live (M5) the Worker answers only on workers.dev, so a deploy
  // can be checked at /_palm/version without touching 1j.nz.
  "workers_dev": true

  // At M5, replace the line above with these routes and retire the zone's
  // redirect rule (palm takes over the browser redirect itself):
  //
  // "workers_dev": false,
  // "routes": [
  //   { "pattern": "1j.nz/*", "zone_name": "1j.nz" }
  // ]
}
