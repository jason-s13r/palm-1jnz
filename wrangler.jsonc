// The 1j.nz Worker, deployed by Workers Builds from the `cloudflare` branch.
// Started from palm's wrangler.template.jsonc.
//
// Every resource below is named, not ID'd: the first `wrangler deploy` finds
// or creates each one by name (automatic provisioning), and later deploys
// reuse it. Nothing needs making by hand in the dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "palm-1jnz",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  // Everything palm keeps. palm creates and migrates its own tables on its
  // first request, so there's no migration step. The admin CLI reaches it by
  // name: pnpm palm user create jason --domain 1j.nz --db palm-1jnz --admin
  "d1_databases": [{ "binding": "DB", "database_name": "palm-1jnz" }],

  // Uploaded images and video.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "palm-1jnz-media" }],

  // Outgoing deliveries. The Worker consumes its own queue.
  "queues": {
    "producers": [{ "binding": "QUEUE", "queue": "palm-1jnz" }],
    // One message per run: each queue job then has the free plan's CPU time to itself.
    "consumers": [{ "queue": "palm-1jnz", "max_batch_size": 1, "max_retries": 5 }]
  },

  // Mastodon streaming: one Durable Object holds the open connections.
  "durable_objects": { "bindings": [{ "name": "STREAMING", "class_name": "PalmStreaming" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PalmStreaming"] }],

  // Every 10 minutes: scheduled posts, moves and deletions go out. The 03:00
  // UTC run also prunes old remote posts nobody here touched.
  "triggers": { "crons": ["*/10 * * * *"] },

  // palm serves all of 1j.nz: federation, both client APIs, its web pages,
  // and the browser redirect to jason.schwarzenberger.co.nz (browserRedirect
  // in palm.config.ts), which replaces the zone's old Redirect Rule.
  "workers_dev": false,
  "routes": [{ "pattern": "1j.nz/*", "zone_name": "1j.nz" }]
}
